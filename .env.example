# =============================================================================
# Kystkonsulent — live data configuration
#
# Copy this file to ".env" (in the repo root or in server/) and fill in values.
# With no .env, the app runs on synthetic demo data.
# =============================================================================

# Master switch. Set to true to fan out to the live sources on single-point
# evaluation. Area scans always use the fast synthetic generator.
LIVE_DATA=true

# MET Norway requires an identifying User-Agent on every request.
# Put a real contact (email or project URL) so MET can reach you if needed.
MET_USER_AGENT=Kystkonsulent/0.1 your-email@example.com

# --- Shipping traffic: BarentsWatch AIS (OAuth2 client credentials) ----------
# Create a free client at https://www.barentswatch.no/minside/ (API access),
# then paste the client id + secret here. Without these, shipping stays synthetic.
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=
# Override only if your account uses a different AIS endpoint:
# BARENTSWATCH_AIS_URL=https://live.ais.barentswatch.no/v1/latest/combined

# --- Temperature: MET Frost (OPTIONAL override) ------------------------------
# Water temperature uses MET oceanforecast (no key) by default. If you set a
# Frost client id (free: https://frost.met.no/auth/requestCredentials.html),
# Frost's nearest sea-water-temperature station is tried first.
FROST_CLIENT_ID=

# --- Protected areas: Naturbase / Miljødirektoratet (no auth) ----------------
# Override if the default ArcGIS layer changes:
# PROTECTED_AREAS_URL=https://kart.miljodirektoratet.no/arcgis/rest/services/vern/MapServer/0

# --- Seafloor depth: GEBCO bathymetry via OpenTopoData (no auth) --------------
# Public instance is rate-limited (~1 req/s, 1000/day); scans batch their depth
# lookups into one request. Point at a self-hosted OpenTopoData for heavy use.
# OPENTOPODATA_URL=https://api.opentopodata.org/v1
# BATHYMETRY_DATASET=gebco2020

# Per-source request timeout (ms).
# SOURCE_TIMEOUT_MS=6000
